# ==============================================================================
# SecureID - Secure Digital Identity Management System
# DevSecOps Lab CIAP Microproject Configuration Template
# ==============================================================================
# WARNING: Do NOT commit sensitive credentials or real secrets to version control.
# Copy this file to .env and configure values appropriate for your environment.

# Server & Network Configuration
NODE_ENV=development
PORT=5000
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000

# Authentication & Security Keys
# Generate a strong 256-bit key in production (e.g. openssl rand -hex 32)
JWT_SECRET=secureid_dev_jwt_secret_change_in_production_key_2026_ciap
JWT_EXPIRES_IN=24h
COOKIE_SECRET=secureid_dev_cookie_secret_change_in_production_2026

# Database Configuration
# Default: Local SQLite database stored in backend/data/secureid.sqlite
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/secureid.sqlite
# For PostgreSQL (optional cloud deployment):
# DATABASE_URL=postgres://secureid_user:secureid_password@localhost:5432/secureid_db

# Security & Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
SUSPICIOUS_LOGIN_THRESHOLD=3

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# DevSecOps & Cloud Deployment Placeholders (Configured in CI/CD secrets)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY_NAME=secureid
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=squ_placeholder_token_for_ci_pipeline
